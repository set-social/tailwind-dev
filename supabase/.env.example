# Edge Function secrets — push with:
#   supabase secrets set --env-file supabase/.env
# Copy this to supabase/.env and fill in (gitignored). Nothing here is
# required to run the app; each function returns 501 and the client falls
# back to mock data until its own key is set.

ANTHROPIC_API_KEY=
AEROAPI_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional — Ask FlightIQ spend limits (UTC day). Defaults shown.
# ASSISTANT_DAILY_LIMIT=25            # questions per user
# ASSISTANT_GLOBAL_DAILY_LIMIT=2000   # questions across everyone (cost circuit breaker)

# Optional — identifies FlightIQ to api.weather.gov (NWS asks API clients to).
# NWS_USER_AGENT="FlightIQ (you@example.com)"
